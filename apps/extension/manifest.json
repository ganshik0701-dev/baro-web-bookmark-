{
  "manifest_version": 3,
  "name": "바로 — 크롬 북마크 동기화",
  "version": "0.1.0",
  "description": "크롬 북마크를 바로(baro)에 동기화합니다.",
  "key": "",
  "permissions": [
    "bookmarks",
    "storage"
  ],
  "host_permissions": [
    "https://baro-web-bookmark-api.vercel.app/*",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "바로"
  }
}
