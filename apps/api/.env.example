# apps/api 전용. Next.js는 이 폴더의 .env만 읽는다.
# 서버 비밀값은 이 파일에만 둔다. Vercel 환경 변수에도 같은 이름으로 넣는다.

SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=

# 서비스 키는 RLS를 건너뛴다. 앱·확장 쪽 .env에 절대 넣지 않는다.
SUPABASE_SERVICE_ROLE_KEY=

# 대시보드 Connect → Session pooler → URI. 직접 연결(db.xxx)은 IPv6 전용이라 집 인터넷에서 안 될 수 있다.
# supabase db push 도 이 값을 쓴다. API 코드는 이 값을 쓰지 않는다.
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

# API가 쿼리할 때 쓰는 주소. 대시보드 Connect → Transaction pooler → URI (포트 6543).
# 서버리스(Vercel)는 요청마다 연결이 생겼다 사라지므로 트랜잭션 풀러를 쓴다.
DATABASE_POOLER_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres
